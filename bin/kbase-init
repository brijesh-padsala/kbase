#!/usr/bin/env python3
"""kbase-init — scaffold an agent-agnostic knowledge base into a git repo.

Creates knowledge/ (structure + policy templates), scripts/ (search, gate,
doctor), agent discovery adapters, and a root AGENTS.md router. Two bootstrap modes:

  existing    repo has real code + history → KB status SCAFFOLDED and a
              knowledge/_bootstrap-brief.md is generated: a mechanical
              evidence pack + distillation checklist for the first agent
              session (the repo itself tells any agent what to do).
  greenfield  young/empty repo → KB status VERIFIED at the init commit;
              the write-back policy grows it from there.

Usage:
  kbase-init [--mode auto|existing|greenfield] [--agents codex,claude|none]
             [--workflow] [--source-dir DIR] [--force] [TARGET_DIR]

Python 3.10+, standard library only.
"""

import argparse
import datetime
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from collections import Counter
from pathlib import Path

TEMPLATE_DIR = Path(__file__).resolve().parent.parent / "template"
VERSION_FILE = TEMPLATE_DIR.parent / "VERSION"
SCRIPTS = ("kbformat.py", "ksearch.py", "knowledge-gate.py", "kbase-doctor.py", "ksearch-eval.py")
AGENT_DIRS = {"codex": ".agents", "claude": ".claude"}
CORE_SKILLS = ("distill", "kb-audit", "kb-handoff")
WORKFLOW_SKILLS = ("kb-plan", "kb-implement", "kb-review", "kb-board")

# The status-line grammar the gate parses lives in the template's kbformat;
# import it so the writer and the reader share one declaration.
sys.path.insert(0, str(TEMPLATE_DIR / "scripts"))
import kbformat  # noqa: E402

# ---------------------------------------------------------------------------
# mode detection + evidence pack constants

SKIP_DIRS = {
    ".git", ".hg", ".svn", "node_modules", ".venv", "venv", "env", "__pycache__",
    "dist", "build", "target", ".tox", ".mypy_cache", ".pytest_cache", ".next",
    ".turbo", "coverage", ".idea", ".vscode", "site-packages", ".gradle", "vendor",
}
EXT_LANG = {
    ".py": "Python", ".rs": "Rust", ".ts": "TypeScript", ".tsx": "TypeScript",
    ".js": "JavaScript", ".jsx": "JavaScript", ".mjs": "JavaScript", ".cjs": "JavaScript",
    ".go": "Go", ".java": "Java", ".kt": "Kotlin", ".rb": "Ruby", ".php": "PHP",
    ".cs": "C#", ".c": "C", ".h": "C", ".cpp": "C++", ".cc": "C++", ".hpp": "C++",
    ".swift": "Swift",
}
KNOWN_PY = {
    "fastapi": "FastAPI", "django": "Django", "flask": "Flask", "celery": "Celery",
    "sqlalchemy": "SQLAlchemy", "pydantic": "Pydantic", "pytest": "pytest",
    "uvicorn": "Uvicorn", "gunicorn": "Gunicorn", "scrapy": "Scrapy", "numpy": "NumPy",
    "pandas": "pandas", "torch": "PyTorch", "maturin": "maturin (Rust ext)",
}
KNOWN_JS = {
    "next": "Next.js", "react": "React", "vue": "Vue", "svelte": "Svelte",
    "express": "Express", "fastify": "Fastify", "nest": "NestJS", "typescript": "TypeScript",
    "vite": "Vite", "webpack": "webpack", "jest": "Jest", "playwright": "Playwright",
    "prisma": "Prisma", "tailwindcss": "Tailwind",
}
KNOWN_RS = {
    "tokio": "Tokio", "axum": "Axum", "actix-web": "Actix Web", "serde": "Serde",
    "sqlx": "sqlx", "pyo3": "PyO3", "clap": "clap", "warp": "warp", "rocket": "Rocket",
}
TEST_BASES = re.compile(r"(^test_|_test\.|\.spec\.|\.test\.|(^|/)conftest\.py$)")
ENTRY_CANDIDATES = [
    "main.py", "app.py", "manage.py", "src/main.rs", "src/lib.rs",
    "main.go", "index.ts", "index.js", "server.js", "app.ts", "Program.cs",
]


def git(cwd, *args, check=True):
    return subprocess.run(  # noqa: S603
        ["git", *args],  # noqa: S607
        cwd=cwd, capture_output=True, text=True, check=check,
    ).stdout


def walk_source(root: Path):
    """(per-language {files, loc}, test_file_count, entry_points_found)."""
    stats, tests, entries = {}, 0, []
    for dirpath, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for n in names:
            ext = os.path.splitext(n)[1].lower()
            if ext in EXT_LANG:
                s = stats.setdefault(EXT_LANG[ext], {"files": 0, "loc": 0})
                s["files"] += 1
                try:
                    with open(os.path.join(dirpath, n), encoding="utf-8", errors="ignore") as fh:
                        s["loc"] += sum(1 for _ in fh)
                except OSError:
                    pass
            if ext in EXT_LANG and TEST_BASES.search(n.lower()):
                tests += 1
        rel = os.path.relpath(dirpath, root)
        for cand in ENTRY_CANDIDATES:
            if os.path.exists(os.path.join(dirpath, cand)) and rel in (".", "src"):
                entries.append(os.path.normpath(os.path.join(rel, cand)))
    return stats, tests, sorted(set(entries))


def detect_stack(root: Path):
    """Frameworks/services the manifests betray, as readable lines."""
    found = []
    pj = root / "package.json"
    if pj.is_file():
        try:
            deps = set()
            data = json.loads(pj.read_text(encoding="utf-8"))
            for key in ("dependencies", "devDependencies"):
                deps |= set(data.get(key, {}))
            found += [KNOWN_JS[d] for d in deps if d in KNOWN_JS]
            if data.get("name"):
                found.append(f"npm package '{data['name']}'")
        except (OSError, ValueError):
            pass
    py_deps = set()
    req = list(root.glob("requirements*.txt")) + [root / "pyproject.toml"]
    for f in req:
        if f.is_file():
            try:
                for line in f.read_text(encoding="utf-8", errors="ignore").splitlines():
                    m = re.match(r"\s*([A-Za-z0-9_.\[\]-]+)\s*[=<>~\[]", line)
                    if m:
                        py_deps.add(m.group(1).lower().replace("_", "-"))
            except OSError:
                pass
    found += [KNOWN_PY[d] for d in py_deps if d in KNOWN_PY]
    cargo = root / "Cargo.toml"
    if cargo.is_file():
        try:
            text = cargo.read_text(encoding="utf-8", errors="ignore")
            found += [KNOWN_RS[d] for d in KNOWN_RS if re.search(rf'^\s*{d}\s*=', text, re.M)]
            m = re.search(r'^\s*name\s*=\s*"([^"]+)"', text, re.M)
            if m:
                found.append(f"Rust crate '{m.group(1)}'")
        except OSError:
            pass
    for f in ("go.mod", "Gemfile", "composer.json", "pom.xml", "build.gradle", "build.gradle.kts"):
        if (root / f).is_file():
            found.append(f"{f} present")
    return sorted(dict.fromkeys(found))


def compose_services(root: Path):
    names = []
    for f in sorted(root.glob("docker-compose*.y*ml")):
        try:
            in_services, indent = False, None
            for line in f.read_text(encoding="utf-8", errors="ignore").splitlines():
                m = re.match(r"^(\s*)([A-Za-z0-9_.-]+):\s*$", line)
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                if not in_services and re.match(r"^services:\s*$", line):
                    in_services, indent = True, None
                    continue
                if in_services:
                    if line and not line[0].isspace():
                        in_services = False
                        continue
                    if m:
                        cur = len(m.group(1))
                        if indent is None:
                            indent = cur
                        if cur == indent:
                            names.append(f"{m.group(2)} (from {f.name})")
        except OSError:
            pass
    return sorted(dict.fromkeys(names))


def git_themes(root: Path):
    total = git(root, "rev-list", "--count", "HEAD").strip()
    first = git(root, "log", "--reverse", "--format=%as").splitlines()[:1]
    subjects = git(root, "log", "--format=%s", "-n", "200").splitlines()
    types, scopes = Counter(), Counter()
    for s in subjects:
        m = re.match(r"^(\w+)(?:\(([^)]+)\))?!?:", s)
        if m:
            types[m.group(1).lower()] += 1
            if m.group(2):
                scopes[m.group(2).lower()] += 1
    return {
        "total": total,
        "first_commit": first[0] if first else "?",
        "type_counts": dict(types.most_common()),
        "top_scopes": [s for s, _ in scopes.most_common(8)],
        "recent": subjects[:5],
    }


def build_brief(project, baseline, date, root: Path, pre_stats):
    stats, tests, entries = pre_stats
    stack = detect_stack(root)
    services = compose_services(root)
    themes = git_themes(root)
    workflows = sorted(p.name for p in (root / ".github" / "workflows").glob("*") if p.is_file()) \
        if (root / ".github" / "workflows").is_dir() else []
    migrations = len(list((root / "alembic" / "versions").glob("*.py"))) \
        if (root / "alembic" / "versions").is_dir() else 0

    lang_lines = "\n".join(
        f"| {lang} | {v['files']} | {v['loc']:,} |" for lang, v in
        sorted(stats.items(), key=lambda kv: -kv[1]["loc"])
    ) or "| (none detected) | | |"
    type_counts = ", ".join(f"{k}: {v}" for k, v in themes["type_counts"].items()) or "(no conventional-commit types)"
    scopes = ", ".join(themes["top_scopes"]) or "(none)"
    recent = "\n".join(f"  - {s}" for s in themes["recent"]) or "  - (none)"

    return f"""# Bootstrap brief — distillation pass for {project}

> Generated by kbase-init {date}. Baseline: `{baseline}`.
> **KB status is SCAFFOLDED until this brief is completed** — nothing in knowledge/ may be
> cited as truth yet. This file is the contract between kbase-init (which gathered the
> mechanics) and you, the distillation agent (who verifies and writes).

## Your job

Turn the evidence pack below into a VERIFIED knowledge base. The procedure is canonical
and already in this repo: **`knowledge/practices/skills/distill.md`** — follow its
Steps 1–7 and Rules of engagement; the evidence pack below is the input it works from.
The non-negotiables:

- Verify every evidence line against the source before building on it (the pack is
  mechanical and can be wrong).
- Write `docs/architecture.md`, `learning/pitfalls.md`, `memory/operations.md` with
  per-claim ✅/❓ labels; fill every `TODO(project)` / `TODO(distillation)` marker.
- Flip the status line in `knowledge/README.md` AND `knowledge/INDEX.md` to
  `VERIFIED @ <commit>` and delete this brief — in ONE commit.
  `scripts/knowledge-gate.py` checks the flip: the named commit must exist, and VERIFIED
  and the brief can never coexist.

## Evidence pack (mechanical — verify before building on it)

### Stack signals
{chr(10).join(f"- {s}" for s in stack) or "- (no manifests detected)"}

### Size and shape
| Language | Files | LOC |
|---|---|---|
{lang_lines}

- Test files detected: {tests}
- Entry points found: {', '.join(entries) or '(none of the usual suspects)'}
- Alembic migrations: {migrations}
- CI workflows: {', '.join(workflows) or '(none detected)'}
- Docker services:
{chr(10).join(f"  - {s}" for s in services) or "  - (no compose files)"}

### Git history ({themes['total']} commits since {themes['first_commit']})
- Conventional-commit types (last 200): {type_counts}
- Most-touched areas (scopes): {scopes}
- Recent subjects:
{recent}

### What the history is hinting at
Recurring `fix` types and hot scopes above are your pitfalls and lessons candidates —
start there when writing `pitfalls.md`.
"""


def render(text: str, values: dict) -> str:
    for key, val in values.items():
        text = text.replace("{{" + key + "}}", val)
    leftover = re.findall(r"\{\{[A-Z_]+\}\}", text)
    if leftover:
        raise SystemExit(f"kbase-init bug: unresolved placeholders {sorted(set(leftover))}")
    return text


def selected_agents(value):
    """Parse a stable, duplicate-free list of supported discovery adapters."""
    if value == "none":
        return []
    agents = value.split(",")
    if not agents or any(agent not in AGENT_DIRS for agent in agents):
        raise argparse.ArgumentTypeError("use codex, claude, codex,claude, or none")
    return list(dict.fromkeys(agents))


def source_roots(root, requested):
    """Keep source paths relative to the repository and inside its boundary."""
    candidates = requested or [p for p in ("src", "lib", "app", "frontend") if (root / p).is_dir()] or ["."]
    result = []
    for value in candidates:
        path = Path(value)
        resolved = (root / path).resolve()
        if path.is_absolute() or not resolved.is_relative_to(root) or not resolved.is_dir():
            raise ValueError(f"--source-dir must name an existing directory inside the repo: {value}")
        rel = resolved.relative_to(root).as_posix()
        if rel not in result:
            result.append(rel)
    return result


def digest(data):
    return hashlib.sha256(data).hexdigest()


def check_destination(root, relative):
    """Managed destinations use regular files and directories within the repo."""
    destination = root / relative
    if not destination.resolve().is_relative_to(root):
        raise ValueError(f"destination escapes the repo: {relative}")
    if destination.is_symlink() or (destination.exists() and not destination.is_file()):
        raise ValueError(f"destination is not a regular file: {relative}")
    for parent in destination.parents:
        if parent == root:
            break
        if parent.is_symlink():
            raise ValueError(f"destination parent is a symlink: {parent.relative_to(root)}")
        if parent.exists() and not parent.is_dir():
            raise ValueError(f"destination parent is not a directory: {parent.relative_to(root)}")
    return destination


def main():
    ap = argparse.ArgumentParser(prog="kbase-init")
    ap.add_argument("target", nargs="?", default=".", help="repo to scaffold (default: cwd)")
    ap.add_argument("--mode", choices=["auto", "existing", "greenfield"], default="auto")
    ap.add_argument("--force", action="store_true", help="overwrite existing template files (review changes first)")
    ap.add_argument("--agents", type=selected_agents, default=selected_agents("codex,claude"),
                    help="discovery adapters: codex,claude (default), codex, claude, or none")
    ap.add_argument("--workflow", action="store_true", help="also install plan, implement, review, and board skill adapters")
    ap.add_argument("--source-dir", action="append", help="existing repo-relative source directory; repeat for multiple roots")
    a = ap.parse_args()

    target = Path(a.target).resolve()
    if not target.is_dir():
        ap.error(f"{target} is not a directory")
    try:
        root = Path(git(target, "rev-parse", "--show-toplevel").strip()).resolve()
    except subprocess.CalledProcessError:
        ap.error(f"{target} is not a git repo — git init and make the first commit first")
    if subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--verify", "--quiet", "HEAD"],
        capture_output=True,
    ).returncode != 0:
        ap.error("repo has no commits — make the first commit first (the KB needs a baseline)")
    if (root / "knowledge").exists() and not a.force:
        ap.error("knowledge/ already exists (use --force to overwrite template files)")
    try:
        roots = source_roots(root, a.source_dir)
    except ValueError as exc:
        ap.error(str(exc))

    # Gather evidence before writing, so the installed scripts do not affect it.
    pre_stats = walk_source(root)
    stats, _, _ = pre_stats
    src_files = sum(v["files"] for v in stats.values())
    commits = int(git_themes(root)["total"] or 0)
    mode = a.mode
    if mode == "auto":
        mode = "existing" if src_files >= 25 and commits >= 15 else "greenfield"
    short = git(root, "rev-parse", "--short", "HEAD").strip()
    full = git(root, "rev-parse", "HEAD").strip()
    date = datetime.date.today().isoformat()
    remote = git(root, "remote", "get-url", "origin", check=False).strip()
    name = re.sub(r"\.git$", "", remote.rsplit("/", 1)[-1]) if remote else root.name
    if mode == "existing":
        status_line = kbformat.render_status(
            "SCAFFOLDED", short, date,
            "structure only; DO NOT cite as truth until the distillation pass "
            "(knowledge/_bootstrap-brief.md) flips this")
        arch_tldr = ("Stub — SCAFFOLDED pending the distillation pass "
                     "(knowledge/_bootstrap-brief.md); do not cite yet.")
    else:
        status_line = kbformat.render_status(
            "VERIFIED", short, date,
            "baseline is the init commit; the KB grows via the write-back policy")
        arch_tldr = ("Fresh project — record tiers and decisions here as they land, "
                     "every claim labeled ✅/❓.")
    values = {
        "PROJECT": name, "BASELINE_SHORT": short, "BASELINE_FULL": full,
        "DATE": date, "STATUS_LINE": status_line, "ARCH_TLDR": arch_tldr,
    }

    # Prepare and validate the complete write set before creating any files.
    files, managed, notices = {}, {}, []
    try:
        for src in sorted((TEMPLATE_DIR / "knowledge").rglob("*")):
            if not src.is_file():
                continue
            rel = src.relative_to(TEMPLATE_DIR / "knowledge")
            out = Path("knowledge") / rel.parent / (rel.stem if rel.suffix == ".tmpl" else rel.name)
            text = src.read_text(encoding="utf-8")
            files[out.as_posix()] = (render(text, values) if rel.suffix == ".tmpl" else text).encode("utf-8")

        for script in SCRIPTS:
            rel = f"scripts/{script}"
            data = (TEMPLATE_DIR / rel).read_bytes()
            dst = check_destination(root, rel)
            if dst.exists() and dst.read_bytes() != data and not a.force:
                ap.error(f"conflicting {rel}; move or rename that file, or review it and rerun with --force")
            files[rel] = data
            managed[rel] = digest(data)

        skills = CORE_SKILLS + (WORKFLOW_SKILLS if a.workflow else ())
        for agent in a.agents:
            for skill in skills:
                rel = f"{AGENT_DIRS[agent]}/skills/{skill}/SKILL.md"
                data = (TEMPLATE_DIR / "skills" / skill / "SKILL.md").read_bytes()
                dst = check_destination(root, rel)
                if dst.exists() and dst.read_bytes() != data and not a.force:
                    notices.append(f"preserved custom {rel}; merge its canonical procedure pointer manually")
                    continue
                files[rel] = data
                managed[rel] = digest(data)

        block = render((TEMPLATE_DIR / "AGENTS.md.tmpl").read_text(encoding="utf-8"), values).encode("utf-8")
        if (root / "AGENTS.md").exists():
            files["knowledge/_agents-router-block.md"] = block
            notices.append("AGENTS.md exists — merge knowledge/_agents-router-block.md into AGENTS.md manually")
        else:
            files["AGENTS.md"] = block
        if "claude" in a.agents:
            claude_block = "# Knowledge base\n\n@AGENTS.md\n".encode("utf-8")
            if (root / "CLAUDE.md").exists():
                existing = (root / "CLAUDE.md").read_text(encoding="utf-8")
                if "@AGENTS.md" not in existing.splitlines():
                    files["knowledge/_claude-router-block.md"] = claude_block
                    notices.append("CLAUDE.md exists — merge knowledge/_claude-router-block.md into CLAUDE.md manually")
            else:
                files["CLAUDE.md"] = claude_block

        gi = root / ".gitignore"
        entry = "knowledge/_ksearch-log.tsv"
        current = gi.read_text(encoding="utf-8") if gi.exists() else ""
        if entry not in current.splitlines():
            files[".gitignore"] = (current + ("\n" if current and not current.endswith("\n") else "") + entry + "\n").encode("utf-8")
        pc = root / ".pre-commit-config.yaml"
        snippet = (TEMPLATE_DIR / ".pre-commit-snippet.yaml").read_bytes()
        if pc.exists():
            if "knowledge-gate" not in pc.read_text(encoding="utf-8"):
                files[".pre-commit-knowledge-gate-snippet.yaml"] = snippet
                notices.append("merge .pre-commit-knowledge-gate-snippet.yaml into .pre-commit-config.yaml")
        else:
            files[".pre-commit-config.yaml"] = snippet
            notices.append("created .pre-commit-config.yaml; activate the hook with `pre-commit install` after installing pre-commit")

        brief_rel = "knowledge/_bootstrap-brief.md"
        brief = check_destination(root, brief_rel)
        remove_brief = False
        manifest = {
            "schema_version": 1,
            "template_version": VERSION_FILE.read_text(encoding="utf-8").strip(),
            "agents": a.agents,
            "workflow": a.workflow,
            "source_roots": roots,
            "managed_files": managed,
        }
        if mode == "existing":
            files[brief_rel] = build_brief(name, short, date, root, pre_stats).encode("utf-8")
            manifest["bootstrap_brief_sha256"] = digest(files[brief_rel])
        elif brief.exists():
            previous_manifest = root / ".kbase.json"
            previous = json.loads(previous_manifest.read_text(encoding="utf-8")) if previous_manifest.exists() else {}
            if not isinstance(previous, dict) or previous.get("bootstrap_brief_sha256") != digest(brief.read_bytes()):
                ap.error("greenfield mode conflicts with an existing bootstrap brief that is modified or not tracked by kbase; "
                         "review and move knowledge/_bootstrap-brief.md before rerunning")
            remove_brief = True
        files[".kbase.json"] = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode("utf-8")
        for rel in files:
            check_destination(root, rel)
    except (OSError, ValueError) as exc:
        ap.error(str(exc))

    print(f"[kbase] target   : {root}")
    print(f"[kbase] mode     : {mode} ({src_files} source files, {commits} commits; override with --mode)")
    print(f"[kbase] agents   : {', '.join(a.agents) or 'none'}")
    print(f"[kbase] sources  : {', '.join(roots)}")
    for rel, data in files.items():
        dst = root / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(data)
        if rel.startswith("scripts/"):
            shutil.copymode(TEMPLATE_DIR / rel, dst)
    if remove_brief:
        brief.unlink()
        notices.append("removed unchanged generated bootstrap brief for greenfield mode")
    for notice in notices:
        print(f"[kbase] {notice}")

    # Always inspect the generated KB, independent of caller cwd/environment.
    env = dict(os.environ, KSEARCH_NO_LOG="1", KB_ROOT=str(root / "knowledge"))
    result = subprocess.run(
        [sys.executable, str(root / "scripts" / "ksearch.py"), "--limit", "3", "--max-bytes", "0", "knowledge"],
        cwd=root, capture_output=True, text=True, env=env,
    )
    valid_no_hits = result.returncode == 1 and result.stdout.strip() == "no matches"
    if (result.returncode != 0 and not valid_no_hits) or result.stderr.strip():
        print(f"[kbase] ERROR: generated ksearch smoke failed (exit {result.returncode})", file=sys.stderr)
        print(result.stderr or result.stdout, file=sys.stderr)
        return 1
    print(f"[kbase] ksearch smoke: {'hits found' if result.returncode == 0 else 'no hits yet (valid empty search)'}")
    gate = subprocess.run(
        [sys.executable, str(root / "scripts" / "knowledge-gate.py"), "--all"],
        cwd=root, capture_output=True, text=True,
    )
    if gate.returncode:
        print("[kbase] ERROR: generated KB failed full-tree validation", file=sys.stderr)
        print(gate.stdout + gate.stderr, file=sys.stderr)
        return 1
    print("[kbase] full-tree gate: passed")

    # Explicit paths include selected dot-directories without staging unrelated files.
    stage_paths = list(files)
    if remove_brief and git(root, "ls-files", "--", brief_rel).strip():
        stage_paths.append(brief_rel)
    stage = "git add -- " + " ".join(shlex.quote(path) for path in sorted(stage_paths))
    status = "SCAFFOLDED (until distilled)" if mode == "existing" else f"VERIFIED @ {short} (init baseline)"
    print(f"\n[kbase] DONE — {len(files)} files. KB status: {status}.")
    if a.agents:
        print("Skill adapters: " + ", ".join(f"{AGENT_DIRS[agent]}/skills/" for agent in a.agents))
    if mode == "existing":
        print('Open an agent session in this repo and say "read AGENTS.md"; the bootstrap rule starts distillation.')
        print("Complete distillation, review the changes, and stage the resulting files before committing.")
        # Distillation deletes the brief; git add of an untracked, removed file would fail.
        print("To stage the scaffold before distillation:")
    else:
        print("Grow the KB via the write-back policy; fill the project placeholders with verified commands and architecture.")
        print("Review changes, then stage the generated files before committing:")
    print("    " + stage)
    return 0


if __name__ == "__main__":
    sys.exit(main())
